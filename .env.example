# ==============================================================================
# BuzzScout Environment Configuration Template (.env.example)
# IMPORTANT: Copy this file to .env.local or .env in production.
# NEVER commit real credentials, passwords, or secret keys to source control.
# ==============================================================================

# 1. Database Connection (PostgreSQL Pooler for Supabase / Neon / AWS RDS)
# Pooler URL (Transaction Mode / PgBouncer port 6543):
DATABASE_URL="postgresql://postgres.<project-ref>:<your-db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct URL (Session Mode / direct Postgres port 5432 for migrations):
DIRECT_URL="postgresql://postgres.<project-ref>:<your-db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# 2. JWT Session Secret (Generate via: openssl rand -base64 48)
JWT_SECRET="<generate_a_random_secure_64_character_string>"

# 3. Application Public Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 4. Background Ingestion & Monitoring Cron Secret (Bearer token for /api/cron/monitor)
CRON_SECRET="<generate_a_random_32_character_token>"

# 5. Master Administrator Access (Strict single-owner enforcement via Google Sign-In)
ADMIN_EMAIL="arifmuneeb81@gmail.com"
ADMIN_NAME="Muneeb Arif"

# 6. Optional: Demo User Password (Used only if self-hosting demo mode)
# DEMO_PASSWORD="<choose_a_demo_password>"

# 7. Optional: Stripe Payments (Can also be configured via Admin Portal CMS)
# STRIPE_SECRET_KEY="sk_live_<your_stripe_secret_key>"
# STRIPE_PUBLISHABLE_KEY="pk_live_<your_stripe_publishable_key>"
# STRIPE_WEBHOOK_SECRET="whsec_<your_stripe_webhook_secret>"
# STRIPE_PAYMENT_LINK="https://buy.stripe.com/<your_link>"
# STRIPE_MONTHLY_LINK="https://buy.stripe.com/<your_monthly_link>"
# STRIPE_LTD_LINK="https://buy.stripe.com/<your_ltd_link>"
# STRIPE_AGENCY_LINK="https://buy.stripe.com/<your_agency_link>"

# 8. Optional: Google Cloud OAuth (For live Google Sign-in on accounts.google.com)
# GOOGLE_CLIENT_ID="<your_client_id>.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="<your_client_secret>"

# 9. Optional: Twitter / X API v2 (Optional: falls back to synthetic radar adapter if not provided)
# TWITTER_BEARER_TOKEN="<your_x_api_v2_bearer_token>"

# 10. Optional: MongoDB Atlas (Optional secondary document store)
# MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority"
# MONGODB_DB_NAME="buzzscout"
