# SignalPulse Environment Configuration

# Database Connection (SQLite local by default, or Postgres for Supabase/Neon)
DATABASE_URL="file:./dev.db"

# JWT Secret for Session Authentication
JWT_SECRET="signalpulse-super-secret-production-jwt-key-2026"

# Next.js App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Background Ingestion / Cron Secret
CRON_SECRET="signalpulse_cron_secret_token_9988"

# Optional: Default Telegram Bot Token (if provided globally)
# TELEGRAM_BOT_TOKEN="your-bot-token"

# Optional: AI Provider (Gemini / OpenAI for enhanced pitch drafting, fallback to smart built-in heuristic generator if not set)
# GEMINI_API_KEY=""
# OPENAI_API_KEY=""

# Optional: Twitter/X Bearer Token (falls back to Syndication search if not set)
# TWITTER_BEARER_TOKEN=""
