# SignalPulse Environment Configuration

# Database Connection (SQLite local by default, or Postgres for Supabase/Neon)
DATABASE_URL="file:./dev.db"

# Optional: MongoDB Atlas Connection (for cloud MongoDB deployment on Vercel)
# MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority"
# MONGODB_DB_NAME="signalpulse"

# JWT Secret for Session Authentication
JWT_SECRET="signalpulse-super-secret-production-jwt-key-2026"

# Next.js App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Background Ingestion / Cron Secret
CRON_SECRET="signalpulse_cron_secret_token_9988"

# Optional: Custom Twitter/X Bearer Token (falls back to search adapter if not provided)
# TWITTER_BEARER_TOKEN=""
