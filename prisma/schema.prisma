// BuzzScout Platform Prisma Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  password     String
  name         String?
  role         String         @default("USER") // USER, ADMIN
  productName  String?        @default("My Product")
  productUrl   String?        @default("https://myproduct.io")
  productPitch String?        @default("An affordable and fast modern solution for founders.")
  plan         String         @default("INACTIVE") // INACTIVE, PRO, LTD, AGENCY
  planStatus   String         @default("PENDING_PAYMENT") // PENDING_PAYMENT, ACTIVE, SUSPENDED
  avatarUrl    String?
  googleId     String?
  trialEndsAt              DateTime?
  emailVerified            Boolean        @default(false)
  emailVerificationToken   String?
  emailVerificationExpires DateTime?
  passwordResetToken       String?
  passwordResetExpires     DateTime?
  failedLoginAttempts      Int            @default(0)
  lockoutUntil             DateTime?
  planExpiresAt            DateTime?
  notes                    String?
  isPinned                 Boolean        @default(false)
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  keywords     Keyword[]
  leads        Lead[]
  channels     AlertChannel[]
}

model Keyword {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  phrase           String
  platform         String    @default("ALL") // ALL, REDDIT, TWITTER
  negativeKeywords String?   // comma-separated, e.g. "hiring, job, intern"
  targetSubreddits String?   // comma-separated, e.g. "startups, Entrepreneur"
  active           Boolean   @default(true)
  leadsCount       Int       @default(0)
  lastCheckedAt    DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  leads            Lead[]
}

model Lead {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  keywordId       String
  keyword         Keyword  @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  platform        String   // REDDIT, TWITTER
  externalId      String   // Reddit submission ID or Tweet ID
  title           String
  content         String
  author          String
  authorUrl       String?
  url             String
  sourceSubreddit String?
  intentScore     String   @default("HIGH") // HIGH, MEDIUM, LOW
  status          String   @default("NEW") // NEW, PITCHED, SAVED, DISMISSED
  pitchDraft      String?
  detectedAt      DateTime @default(now())

  @@unique([userId, externalId])
}

model AlertChannel {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String   // TELEGRAM, DISCORD
  telegramBotToken  String?
  telegramChatId    String?
  discordWebhookUrl String?
  active            Boolean  @default(true)
  lastError         String?
  errorCount        Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model LicenseKey {
  id            String    @id @default(cuid())
  code          String    @unique
  plan          String    @default("LTD")
  isUsed        Boolean   @default(false)
  usedByEmail   String?
  lockedToEmail String?
  expiresAt     DateTime?
  isPinned      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  redeemedAt    DateTime?
}

model SiteConfig {
  id                    String   @id @default("default")
  heroHeadline          String   @default("Turn Reddit & X Conversations Into Paying Customers on Autopilot.")
  heroSubtitle          String   @default("Monitor high-intent phrases like 'looking for alternative to X' or 'recommend tool for Y'. Get instant alerts on Telegram & Discord with ready-to-pitch AI replies in under 60 seconds.")
  announcementText      String   @default("Stop paying $100+/month for legacy enterprise monitors — Claim $35 Lifetime Access")
  ctaButtonText         String   @default("Launch Radar")
  telegramBotUrl        String?  @default("https://t.me/BotFather")
  telegramBotToken      String?
  supportEmail          String?  @default("support@buzzscout.io")
  trialDays             Int      @default(7)
  monthlyPrice          Int      @default(5)
  ltdPrice              Int      @default(25)
  ltdOfferActive        Boolean  @default(true)
  agencyPrice           Int      @default(79)
  stripeSecretKey       String?
  stripePublishableKey  String?
  stripePaymentLink     String?
  stripeMonthlyLink     String?
  stripeLtdLink         String?
  stripeAgencyLink      String?
  stripeWebhookSecret   String?
  paymentMode           String   @default("TEST") // LIVE, TEST
  updatedAt             DateTime @updatedAt
}

model PaymentTransaction {
  id              String   @id @default(cuid())
  userId          String?
  userEmail       String
  amount          Float
  currency        String   @default("usd")
  plan            String   // PRO, LTD, AGENCY
  status          String   @default("COMPLETED") // COMPLETED, PENDING, FAILED
  paymentMethod   String   @default("CARD") // STRIPE, CARD
  stripeSessionId String?
  cardLast4       String?
  createdAt       DateTime @default(now())
}

model SecurityAlert {
  id              String   @id @default(cuid())
  ipAddress       String
  userAgent       String?
  attemptedEmail  String
  eventType       String   // UNAUTHORIZED_ADMIN_ATTEMPT, BRUTE_FORCE_BLOCKED, TAMPER_PROBE
  severity        String   @default("HIGH") // MEDIUM, HIGH, CRITICAL
  details         String?
  resolved        Boolean  @default(false)
  ipBlocked       Boolean  @default(false)
  createdAt       DateTime @default(now())
}

model BlockedIp {
  id        String   @id @default(cuid())
  ipAddress String   @unique
  reason    String?
  blockedBy String   @default("ADMIN")
  createdAt DateTime @default(now())
}



