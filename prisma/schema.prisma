// SignalPulse Platform Prisma Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  password     String
  name         String?
  role         String         @default("USER") // USER, ADMIN
  productName  String?        @default("My Product")
  productUrl   String?        @default("https://myproduct.io")
  productPitch String?        @default("An affordable and fast modern solution for founders.")
  plan         String         @default("TRIAL") // TRIAL, PRO, LTD
  planStatus   String         @default("ACTIVE") // ACTIVE, SUSPENDED
  trialEndsAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  keywords     Keyword[]
  leads        Lead[]
  channels     AlertChannel[]
}

model Keyword {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  phrase           String
  platform         String    @default("ALL") // ALL, REDDIT, TWITTER
  negativeKeywords String?   // comma-separated, e.g. "hiring, job, intern"
  targetSubreddits String?   // comma-separated, e.g. "startups, Entrepreneur"
  active           Boolean   @default(true)
  leadsCount       Int       @default(0)
  lastCheckedAt    DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  leads            Lead[]
}

model Lead {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  keywordId       String
  keyword         Keyword  @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  platform        String   // REDDIT, TWITTER
  externalId      String   // Reddit submission ID or Tweet ID
  title           String
  content         String
  author          String
  authorUrl       String?
  url             String
  sourceSubreddit String?
  intentScore     String   @default("HIGH") // HIGH, MEDIUM, LOW
  status          String   @default("NEW") // NEW, PITCHED, SAVED, DISMISSED
  pitchDraft      String?
  detectedAt      DateTime @default(now())

  @@unique([userId, externalId])
}

model AlertChannel {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String   // TELEGRAM, DISCORD
  telegramBotToken  String?
  telegramChatId    String?
  discordWebhookUrl String?
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model LicenseKey {
  id          String    @id @default(cuid())
  code        String    @unique
  plan        String    @default("LTD")
  isUsed      Boolean   @default(false)
  usedByEmail String?
  createdAt   DateTime  @default(now())
  redeemedAt  DateTime?
}

model SiteConfig {
  id                    String   @id @default("default")
  heroHeadline          String   @default("Turn Reddit & X Conversations Into Paying Customers on Autopilot.")
  heroSubtitle          String   @default("Monitor high-intent phrases like 'looking for alternative to X' or 'recommend tool for Y'. Get instant alerts on Telegram & Discord with ready-to-pitch AI replies in under 60 seconds.")
  announcementText      String   @default("Stop paying $100+/month for legacy enterprise monitors — Claim $39 Lifetime Access")
  trialDays             Int      @default(7)
  monthlyPrice          Int      @default(9)
  ltdPrice              Int      @default(39)
  agencyPrice           Int      @default(79)
  stripeSecretKey       String?
  stripePublishableKey  String?
  stripePaymentLink     String?
  stripeWebhookSecret   String?
  paymentMode           String   @default("TEST") // LIVE, TEST
  updatedAt             DateTime @updatedAt
}

model PaymentTransaction {
  id              String   @id @default(cuid())
  userId          String?
  userEmail       String
  amount          Float
  currency        String   @default("usd")
  plan            String   // PRO, LTD, AGENCY
  status          String   @default("COMPLETED") // COMPLETED, PENDING, FAILED
  paymentMethod   String   @default("CARD") // STRIPE, CARD
  stripeSessionId String?
  cardLast4       String?
  createdAt       DateTime @default(now())
}

